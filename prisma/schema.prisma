generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  BECARIO
  DEPENDENCIA
}

enum EstadoRegistro {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoEscaneo {
  INICIO
  FIN
}

enum EstadoTarea {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
}

enum EstadoSolicitudStaff {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Usuario {
  id           String       @id @default(cuid())
  nombre       String
  email        String?      @unique
  passwordHash String
  rol          Rol
  activo       Boolean      @default(true)
  // true mientras el usuario conserve la clave inicial o una asignada por el admin
  debeCambiarClave Boolean  @default(false)
  becario      Becario?
  dependencia  Dependencia?
  creadoEn     DateTime     @default(now())

  @@index([rol, activo])
}

// CRM: ficha del becario
model Becario {
  id                     String            @id @default(cuid())
  usuarioId              String            @unique
  usuario                Usuario           @relation(fields: [usuarioId], references: [id])
  documento              String            @unique
  promocion              String?
  programa               String
  semestre               Int?
  telefono               String?
  horasRequeridas        Int               @default(100)
  servicioPeriodoLectivo String            @default("En curso")
  registros              RegistroHoras[]
  asignaciones           AsignacionStaff[]
  dependenciasAsignadas  AsignacionDependencia[]
  solicitudesStaff       SolicitudStaffBecario[]
  tareas                 Tarea[]
  seguimientos           Seguimiento[]
  escaneos               Escaneo[]
  creadoEn               DateTime                @default(now())
}

// CRM: historial de contacto con el becario
model Seguimiento {
  id        String   @id @default(cuid())
  becarioId String
  becario   Becario  @relation(fields: [becarioId], references: [id], onDelete: Cascade)
  tipo      String   // llamada, reunión, correo, observación
  nota      String
  fecha     DateTime @default(now())

  @@index([becarioId, fecha(sort: Desc)])
}

model Dependencia {
  id          String          @id @default(cuid())
  nombre      String          @unique
  responsable String
  email       String?
  activa      Boolean         @default(true)
  usuarioId        String?                 @unique
  usuario          Usuario?                @relation(fields: [usuarioId], references: [id])
  registros        RegistroHoras[]
  becarios         AsignacionDependencia[]
  solicitudesStaff SolicitudStaff[]

  @@index([activa])
  @@index([email])
}

model AsignacionDependencia {
  id            String      @id @default(cuid())
  dependenciaId String
  dependencia   Dependencia @relation(fields: [dependenciaId], references: [id], onDelete: Cascade)
  becarioId     String
  becario       Becario     @relation(fields: [becarioId], references: [id], onDelete: Cascade)
  creadoEn      DateTime    @default(now())

  @@unique([dependenciaId, becarioId])
  @@index([dependenciaId])
  @@index([becarioId])
}

model SolicitudStaff {
  id                String                  @id @default(cuid())
  dependenciaId     String
  dependencia       Dependencia             @relation(fields: [dependenciaId], references: [id], onDelete: Cascade)
  nombreEvento      String
  fecha             DateTime
  horaInicio        String
  horaFin           String
  cantidadRequerida Int
  descripcion       String
  estado            EstadoSolicitudStaff    @default(PENDIENTE)
  observacionAdmin  String?
  jornadas          SolicitudStaffJornada[]
  becarios          SolicitudStaffBecario[]
  creadoEn          DateTime                @default(now())
  actualizadoEn     DateTime                @updatedAt

  @@index([dependenciaId])
  @@index([estado, fecha])
}

model SolicitudStaffJornada {
  id                String                  @id @default(cuid())
  solicitudId       String
  solicitud         SolicitudStaff          @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  orden             Int                     @default(1)
  fecha             DateTime
  horaInicio        String
  horaFin           String
  cantidadRequerida Int
  becarios          SolicitudStaffBecario[]

  @@index([solicitudId, orden])
}

model SolicitudStaffBecario {
  id          String                 @id @default(cuid())
  solicitudId String
  solicitud   SolicitudStaff         @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  jornadaId   String?
  jornada     SolicitudStaffJornada? @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  becarioId   String
  becario     Becario                @relation(fields: [becarioId], references: [id], onDelete: Cascade)

  @@unique([solicitudId, jornadaId, becarioId])
  @@index([jornadaId])
  @@index([becarioId])
}

model RegistroHoras {
  id            String         @id @default(cuid())
  becarioId     String
  becario       Becario        @relation(fields: [becarioId], references: [id])
  dependenciaId String
  dependencia   Dependencia    @relation(fields: [dependenciaId], references: [id])
  fecha         DateTime
  horas         Decimal        @db.Decimal(4, 1)
  actividad     String
  estado        EstadoRegistro @default(PENDIENTE)
  creadoEn      DateTime       @default(now())

  @@index([becarioId])
  @@index([becarioId, estado])
  @@index([dependenciaId])
  @@index([estado])
  @@index([creadoEn(sort: Desc)])
}

model Evento {
  id           String            @id @default(cuid())
  nombre       String
  fecha        DateTime
  lugar        String
  cupos        Int
  asignaciones AsignacionStaff[]

  @@index([fecha])
}

model AsignacionStaff {
  id        String  @id @default(cuid())
  eventoId  String
  evento    Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  becarioId String
  becario   Becario @relation(fields: [becarioId], references: [id])
  funcion   String  // logística, registro, protocolo...
  horas     Decimal @db.Decimal(4, 1) @default(0)

  @@unique([eventoId, becarioId])
  @@index([becarioId])
}

model Tarea {
  id          String      @id @default(cuid())
  becarioId   String
  becario     Becario     @relation(fields: [becarioId], references: [id])
  titulo      String
  descripcion String?
  fechaLimite DateTime
  estado      EstadoTarea @default(PENDIENTE)
  creadoEn    DateTime    @default(now())

  @@index([becarioId])
  @@index([fechaLimite])
}

// Módulo de Horario y Disponibilidad (integrado desde horario-app)
model Student {
  id              String     @id // documento
  nombre_completo String
  nombre_norm     String
  promo           String?
  correo          String?
  contacto        String?
  municipio       String?
  programa        String?
  actualizado_en  String?
  schedules       Schedule[]

  @@index([nombre_norm])
}

model Schedule {
  id              Int      @id @default(autoincrement())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  promocion       String?
  periodo         String?
  dia             String

  hora_inicio     String   // e.g. "06:30"
  hora_fin        String   // e.g. "08:30"
  hora_inicio_min Int      // e.g. 390
  hora_fin_min    Int      // e.g. 510

  prog            String?
  codigo_clase    String?
  materia         String
  docente         String?

  @@index([studentId])
  @@index([dia, hora_inicio_min, hora_fin_min])
}

// Módulo de Asistencia y QR (portado desde QROA)
model Reunion {
  id       String    @id @default(cuid())
  nombre   String
  fecha    DateTime  @default(now())
  creadoEn DateTime  @default(now())
  escaneos Escaneo[]

  @@index([fecha(sort: Desc)])
}

model Escaneo {
  id        String      @id @default(cuid())
  reunionId String
  reunion   Reunion     @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  becarioId String
  becario   Becario     @relation(fields: [becarioId], references: [id], onDelete: Cascade)
  tipo      TipoEscaneo
  fecha     DateTime    @default(now())

  // Un becario tiene como máximo un INICIO y un FIN por reunión
  @@unique([reunionId, becarioId, tipo])
  @@index([becarioId])
}
