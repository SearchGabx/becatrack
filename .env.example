# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# PostgreSQL: conexión directa (Neon en local, RDS en producción). Agrega ?sslmode=require en Neon.
DATABASE_URL="postgresql://usuario:clave@host:5432/becatrack?sslmode=require"
# Opcional: conexión con pooler para las consultas de la app (si no se define, se usa DATABASE_URL)
# En Neon con endpoint -pooler agrega: ?sslmode=require&pgbouncer=true&connection_limit=10&connect_timeout=15
DATABASE_URL_POOLED=""

# Auth.js: genera uno con `npx auth secret` o `openssl rand -base64 32`.
# También firma los códigos QR de asistencia.
AUTH_SECRET=""
# Necesario detrás de proxy inverso / en producción
AUTH_TRUST_HOST=true

# Solo para `npm run db:seed`
HORARIO_DATABASE_URL=""
BECATRACK_ADMIN_PASSWORD=""
